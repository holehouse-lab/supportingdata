# .gitignore for the Figure 2B analysis.
#
# The plotting notebook (Figure2B.ipynb) and the rendered figure (Fig2B_*.pdf)
# are tracked. Its input tables now live in data/viral_proteomes/ at the top of
# the repository (see the README there); the rules below only keep stray local
# copies of them out of this directory.

# --- Stray copies of the input tables (the real ones are in data/viral_proteomes/) -
viral_proteome_fraction_disorder_by_prot_and_total_proteome.tsv
viral_proteome_id_to_count.tsv
viruses_w_lineage.tsv
# Catch-all so any additional prediction tables dropped in here stay untracked.
*.tsv

# --- Jupyter / Python cruft -------------------------------------------------------
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- OS / editor cruft ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/
